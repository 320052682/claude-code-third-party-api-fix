# Claude Code + MiMo 兼容性修复

## 问题描述

### 触发条件
- Claude Code 版本 >= 2.1.154
- 使用小米 MiMo 模型（通过 `ANTHROPIC_BASE_URL` 代理接入）
- 其他第三方 Anthropic 兼容 API（DeepSeek、智谱等）

### 错误信息
```
messages[1].role must be either 'user' or 'assistant', but got 'system'
```

或 HTTP 400 错误。

### 根本原因
Claude Code 2.1.154+ 引入 **Lean system prompt** 作为默认配置，改变了 system 消息的传递方式：

**旧格式（< 2.1.154）：**
```json
{
  "system": "你是一个助手",
  "messages": [
    {"role": "user", "content": "你好"}
  ]
}
```

**新格式（>= 2.1.154）：**
```json
{
  "messages": [
    {"role": "system", "content": "你是一个助手"},
    {"role": "user", "content": "你好"}
  ]
}
```

MiMo 的 Anthropic 兼容端点只接受旧格式，不接受 `messages[]` 中的 `role: "system"`。

### 影响范围
| 厂商 | 状态 |
|------|------|
| Anthropic 原生 API | ✓ 已支持 |
| 小米 MiMo | ❌ 未适配 |
| DeepSeek | ❌ 未适配 |
| 智谱 GLM-5 | ❌ 未适配 |
| 大多数第三方 | ❌ 未适配 |

---

## 解决方案

使用本地代理在 Claude Code 和 MiMo API 之间转换格式。

### 架构图

```
┌─────────────────┐      ┌─────────────────┐      ┌─────────────────┐
│   Claude Code   │      │   本地代理       │      │    MiMo API     │
│   (154+)        │ ───> │   (端口 4567)    │ ───> │                 │
│                 │      │                 │      │                 │
│ messages: [     │      │ 1. 提取system   │      │ system: [...]   │
│   {role:system} │      │ 2. 放到顶层     │      │ messages: [     │
│   {role:user}   │      │ 3. 转发请求     │      │   {role:user}   │
│ ]               │      │                 │      │ ]               │
└─────────────────┘      └─────────────────┘      └─────────────────┘
```

---

## 完整配置步骤

### 步骤 1：设置环境变量

在 `~/.zshrc`（或 `~/.bashrc`）中添加：

```bash
# ============================================================
# MiMo + Claude Code 配置
# ============================================================

# MiMo API 密钥（从 https://platform.xiaomimimo.com 获取）
export MIMO_API_KEY="your-mimo-api-key-here"

# Claude Code 配置 - 指向本地代理（不要直接指向远端）
export ANTHROPIC_BASE_URL="http://127.0.0.1:4567"
export ANTHROPIC_AUTH_TOKEN="$MIMO_API_KEY"

# 模型配置 - 所有角色都指向 mimo-v2.5-pro
export ANTHROPIC_MODEL="mimo-v2.5-pro"
export ANTHROPIC_DEFAULT_OPUS_MODEL="mimo-v2.5-pro"
export ANTHROPIC_DEFAULT_SONNET_MODEL="mimo-v2.5-pro"
export ANTHROPIC_DEFAULT_HAIKU_MODEL="mimo-v2.5-pro"
export CLAUDE_CODE_SUBAGENT_MODEL="mimo-v2.5-pro"

# 可选：effort 级别
export CLAUDE_EFFORT="high"
```

**重要：** `ANTHROPIC_BASE_URL` 必须指向本地代理 `http://127.0.0.1:4567`，不能直接指向 MiMo 远端。

### 步骤 2：创建代理脚本

创建文件 `~/.claude/claude-mimo-proxy.js`：

```javascript
#!/usr/bin/env node
/**
 * claude-mimo-proxy
 * 
 * 修复 Claude Code 2.1.154+ 与 MiMo API 的兼容性问题。
 * 
 * 功能：
 * - 接收 Claude Code 的请求
 * - 将 messages[] 中的 role:"system" 消息提取到顶层 system 字段
 * - 转发到 MiMo API
 * - 返回响应给 Claude Code
 * 
 * 用法：
 *   node claude-mimo-proxy.js &
 * 
 * 环境变量：
 *   PORT - 代理端口（默认 4567）
 *   MIMO_BASE_URL - MiMo API 地址（默认 https://token-plan-sgp.xiaomimimo.com）
 */

const http = require('http');
const https = require('https');

// ============================================================
// 配置
// ============================================================
const MIMO_BASE = process.env.MIMO_BASE_URL || 'https://token-plan-sgp.xiaomimimo.com';
const PORT = parseInt(process.env.PORT || '4567', 10);
const MIMO_HOSTNAME = new URL(MIMO_BASE).hostname;

// ============================================================
// 核心函数：修复请求体
// ============================================================
function fixRequestBody(body) {
  try {
    const data = JSON.parse(body);
    
    // 如果没有 messages 数组，直接返回
    if (!Array.isArray(data.messages)) {
      return body;
    }

    // 分离 system 消息和其他消息
    const systemParts = [];
    const cleanMessages = [];

    for (const msg of data.messages) {
      if (msg.role === 'system') {
        // 提取 system 消息内容
        if (typeof msg.content === 'string') {
          systemParts.push(msg.content);
        } else if (Array.isArray(msg.content)) {
          // 处理 content blocks 格式
          for (const block of msg.content) {
            if (typeof block === 'string') {
              systemParts.push(block);
            } else if (block.type === 'text' && block.text) {
              systemParts.push(block.text);
            }
          }
        }
      } else {
        // 保留 user 和 assistant 消息
        cleanMessages.push(msg);
      }
    }

    // 如果有 system 消息，合并到顶层 system 字段
    if (systemParts.length > 0) {
      // 合并已有的 system 字段
      const existing = data.system;
      if (typeof existing === 'string') {
        systemParts.unshift(existing);
      } else if (Array.isArray(existing)) {
        for (const block of existing) {
          if (typeof block === 'string') {
            systemParts.unshift(block);
          } else if (block.type === 'text' && block.text) {
            systemParts.unshift(block.text);
          }
        }
      }

      // 设置为 Anthropic 格式的 system 字段
      data.system = systemParts.map(text => ({ type: 'text', text }));
      data.messages = cleanMessages;
    }

    return JSON.stringify(data);
  } catch (e) {
    // 解析失败，原样返回
    console.error('[proxy] Failed to parse request body:', e.message);
    return body;
  }
}

// ============================================================
// 转发请求
// ============================================================
function forwardRequest(clientReq, clientRes) {
  let body = [];

  clientReq.on('data', chunk => body.push(chunk));
  
  clientReq.on('end', () => {
    const rawBody = Buffer.concat(body).toString('utf8');
    const fixedBody = fixRequestBody(rawBody);

    // 构建目标路径
    const targetPath = clientReq.url.startsWith('/anthropic')
      ? clientReq.url
      : '/anthropic' + clientReq.url;

    // 构建请求选项
    const options = {
      hostname: MIMO_HOSTNAME,
      port: 443,
      path: targetPath,
      method: clientReq.method,
      headers: {
        ...clientReq.headers,
        host: MIMO_HOSTNAME,
      },
    };

    // 更新 content-length（因为 body 可能已改变）
    delete options.headers['content-length'];
    options.headers['content-length'] = Buffer.byteLength(fixedBody);

    // 发送请求到 MiMo API
    const proxyReq = https.request(options, (proxyRes) => {
      clientRes.writeHead(proxyRes.statusCode, proxyRes.headers);
      proxyRes.pipe(clientRes);
    });

    proxyReq.on('error', (err) => {
      console.error('[proxy] Error forwarding request:', err.message);
      clientRes.writeHead(502, { 'Content-Type': 'application/json' });
      clientRes.end(JSON.stringify({
        type: 'error',
        error: { type: 'proxy_error', message: err.message }
      }));
    });

    proxyReq.write(fixedBody);
    proxyReq.end();
  });
}

// ============================================================
// 启动服务器
// ============================================================
const server = http.createServer((req, res) => {
  console.log(`[proxy] ${new Date().toISOString()} ${req.method} ${req.url}`);
  forwardRequest(req, res);
});

server.listen(PORT, '127.0.0.1', () => {
  console.log(`[proxy] ==========================================`);
  console.log(`[proxy] claude-mimo-proxy started`);
  console.log(`[proxy] Listening on: http://127.0.0.1:${PORT}`);
  console.log(`[proxy] Forwarding to: ${MIMO_BASE}`);
  console.log(`[proxy] ==========================================`);
  console.log(`[proxy] Set in ~/.zshrc:`);
  console.log(`[proxy]   export ANTHROPIC_BASE_URL="http://127.0.0.1:${PORT}"`);
  console.log(`[proxy] ==========================================`);
});

server.on('error', (err) => {
  if (err.code === 'EADDRINUSE') {
    console.error(`[proxy] ERROR: Port ${PORT} is already in use`);
    console.error(`[proxy] Run: lsof -i :${PORT} && kill -9 <PID>`);
  } else {
    console.error('[proxy] Server error:', err);
  }
  process.exit(1);
});
```

### 步骤 3：启动代理

```bash
# 启动代理（后台运行）
node ~/.claude/claude-mimo-proxy.js &

# 验证代理运行
curl -s http://127.0.0.1:4567
# 应返回 404（正常，根路径无服务）
```

### 步骤 4：重新加载环境变量

```bash
source ~/.zshrc
```

### 步骤 5：重启 Claude Code

```bash
# 退出当前会话
exit

# 重新启动
claude
```

